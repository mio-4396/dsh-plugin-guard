{
  "name": "dsh-plugin-guard",
  "version": "0.2.1",
  "type": "module",
  "description": "Preflight a DSH plugin install or update: boot it in an isolated probe profile and refuse the change when DSH would crash or the plugin would be skipped.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "guard",
    "preflight",
    "crash"
  ],
  "homepage": "https://github.com/mio-4396/dsh-plugin-guard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mio-4396/dsh-plugin-guard.git"
  },
  "bugs": {
    "url": "https://github.com/mio-4396/dsh-plugin-guard/issues"
  },
  "author": "mio-4396",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DESIGN.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
